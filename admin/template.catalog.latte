{extends file('body.latte')}

{define search}
    {if canEditAsAdmin()}
        {include file('include/search.latte'),
        placeholder: text('template.search'),
        target: '#index',
        search: null
        }
    {/if}
{/define}

{block main}
    <main class="grow p-4 w-full max-w-5xl mx-auto">
        <div class="space-y-4">
            <h1 class="leading-none text-6xl font-bold">{text('template.catalog')}</h1>

            <div id="index" n:if="!empty($catalog)" class="grid md:grid-cols-3 gap-4 sm:grid-cols-2 grid-cols-1">
                {if canEditAsSuperAdmin()}
                    {foreach $catalog as $key => $template}
                        <div class="card bg-base-100 shadow-sm">
                            <div class="card-body">
                                <h2 class="card-title">
                                    {$template['extra']['ivy']['name'] ?? $template['package']}
                                </h2>
                                <div>
                                    <span n:if="!empty($template['versions'])" class="badge badge-sm badge-soft badge-accent font-bold">
                                        {$template['versions'][0]}
                                    </span>
                                    <span n:if="isset($template['extra']['ivy']['type'])" class="badge badge-sm badge-soft badge-info font-bold">
                                        {$template['extra']['ivy']['type']}
                                    </span>
                                    {if $template['model']}
                                        <div class="badge badge-sm badge-soft badge-secondary font-bold">
                                            {include file('include/status.latte'), status: $template['model']->status, url: '/admin/template/'. $template['model']->id.'/status'}
                                        </div>
                                    {/if}
                                </div>
                                <p>
                                    {isset($template['description']) ? $template['description'] : ""}
                                </p>
                                <div class="card-actions">
                                    {if ! $template['model']}
                                        <form class="block w-full" method="POST" ts-req="{path('BASE_PATH') . 'admin/template/add'}" ts-data="package={$template['package']}" ts-target="target">
                                            {csrf()}
                                            {button
                                                class:'btn btn-block btn-primary shadow-none',
                                                type:confirm,
                                                name:'template_install',
                                                text:text('button.install'),
                                                value:$key,
                                                id:$key,
                                                placeholder:$template['extra']['ivy']['name'] ?? $template['package']
                                            }
                                        </form>
                                    {else}
                                        <form class="block w-full" ts-req="{path('BASE_PATH') . 'admin/template/'.$template['model']->id.'/delete'}" ts-target="target" method="POST" enctype="multipart/form-data">
                                            {csrf()}
                                            {button
                                                class:'btn btn-block btn-soft btn-primary shadow-none',
                                                type:confirm,
                                                name:'template_install',
                                                text:text('button.uninstall'),
                                                value:$template['model']->id,
                                                id:$template['model']->id,
                                                placeholder:$template['model']->name
                                            }
                                        </form>
                                    {/if}
                                </div>
                            </div>
                        </div>
                    {/foreach}
                {/if}
            </div>
            <div n:else class="text-center">
                {text('template.none_available')}
            </div>

    </main>
{/block}